        "OTIO_SCHEMA": "RationalTime.1",
        "value": 85,
        "rate": 30
       },
       "duration": {
        "OTIO_SCHEMA": "RationalTime.1",
        "value": 180,
        "rate": 30
       }
      },
      "media_references": {
