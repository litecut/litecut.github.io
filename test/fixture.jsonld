     {
      "OTIO_SCHEMA": "Clip.2",
      "@id": "#fable/fox-and-stork/line/L3",
      "@type": "Quotation",
      "name": "L3",
      "text": "My dear Stork, you must dine with me tomorrow. I've made a soup you won't soon forget.",
      "spokenByCharacter": {
       "@id": "../../universe.jsonld#char/fox"
      },
      "actor": {
       "@id": "#fable/fox-and-stork/voice/fox"
      },
      "source_range": {
