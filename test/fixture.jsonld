     {
      "OTIO_SCHEMA": "Clip.2",
      "@id": "#fable/fox-and-stork/line/L1",
      "@type": "Quotation",
      "name": "L1",
      "text": "The Fox and the Stork were always calling on one another. To anyone watching, they were the very best of friends.",
      "spokenByCharacter": {
       "@id": "../../universe.jsonld#char/narrator"
      },
      "actor": {
       "@id": "#fable/fox-and-stork/voice/narrator"
